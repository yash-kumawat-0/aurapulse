# ============================================
# AuraPulse Environment Variables
# Copy this file to backend/.env and fill in
# ============================================

# --- Supabase (PostgreSQL) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Maps Platform ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Google Gemini AI (single key or comma-separated failover pool) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEYS=your-primary-key,your-backup-key-if-quota-exhausts

# --- Upstash Redis (Serverless Cache) ---
UPSTASH_REDIS_URL=your-upstash-redis-url
UPSTASH_REDIS_TOKEN=your-upstash-redis-token

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
